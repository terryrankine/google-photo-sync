TZ=Australia/Perth
PHOTOS=/mnt/nas/photos
SINCE=2026-11-24
WAIT_HOURS=4
# Camera makes to send, comma separated. Everything else is skipped. Empty: NIKON
CAMERAS=
# What to take out of the sent copy: mpf, serial, gps, previews, names, maker. Empty: mpf
SCRUB=
# Where the LAN desktop of Chrome listens
LAN_ADDRESS=192.0.2.1
CHROME_USER=
CHROME_PASSWORD=
# Pin by digest: lscr.io/linuxserver/chrome@sha256:...
CHROME_IMAGE=lscr.io/linuxserver/chrome:latest
# The folder that holds gphoto/
SOURCE=..
SITE_HOST=photos.example.org
CF_ACCESS_TEAM=https://example.cloudflareaccess.com
CF_ACCESS_AUD=
ALLOWED_EMAIL=
