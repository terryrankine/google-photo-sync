# Copy to .env.otel to send metrics, logs and traces. Standard names only.
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
OTEL_SERVICE_NAME=gphoto
# OTEL_EXPORTER_OTLP_HEADERS=authorization=...
# OTEL_METRIC_EXPORT_INTERVAL=60000
# OTEL_TRACES_EXPORTER=none
# Photo paths hold family folder names. Left out unless this is true.
# OTEL_GPHOTO_PATHS=true
